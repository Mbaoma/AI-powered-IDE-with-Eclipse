# Copy to config/gcp/deploy.env and fill in your own values.
# config/gcp/deploy.env is gitignored -- DO NOT COMMIT THIS.
# All scripts/gcp-*.sh scripts source this file.

# --- Required: your GCP project ---
PROJECT_ID=
REGION=us-central1

# --- Artifact Registry ---
REPOSITORY=ai-ide
IMAGE_NAME=ai-ide

# Workstation VM identity, created by scripts/gcp-enable-apis.sh and granted
# just enough IAM to pull the image and report health
SERVICE_ACCOUNT_ID=

# Secret Manager resource name for GOOGLE_API_KEY (Phase 3). The key's
# VALUE lives only in config/.env and Secret Manager -- never in a gcloud
# CLI argument, Workstations config field, or audit log.
GOOGLE_API_KEY_SECRET_ID=google-api-key

# --- Cloud Workstations ---
CLUSTER_ID=
CONFIG_ID=
WORKSTATION_ID=
MACHINE_TYPE=e2-standard-4
BOOT_DISK_SIZE_GB=50
PERSISTENT_DISK_TYPE=pd-balanced
PERSISTENT_DISK_SIZE_GB=50
IDLE_TIMEOUT_SECONDS=1200
RUNNING_TIMEOUT_SECONDS=43200

# --- Networking (scripts/gcp-network-setup.sh) ---
# Leave as "default" to use the project's default VPC
NETWORK=default
SUBNETWORK=default
